# =========================================
# Gitignore for multi-project React repository
# Covers CRA and Vite projects
# =========================================

# -----------------------------------------
# Node modules (all projects)
# -----------------------------------------
**/node_modules/
.pnp
.pnp.js

# -----------------------------------------
# Build / Distribution folders
# CRA: build, Vite: dist
# -----------------------------------------
**/build/
**/dist/

# -----------------------------------------
# Environment files
# -----------------------------------------
**/.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# -----------------------------------------
# Testing / Coverage
# -----------------------------------------
/coverage/

# -----------------------------------------
# Logs
# -----------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------
# OS / Misc
# -----------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------
# Optional: IDE / Editor files
# -----------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln






#for next

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

